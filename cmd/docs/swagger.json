                            }
                        }
                    },
                    "400": {
                        "description": "Invalid ID format or pagination parameters",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to retrieve reviews",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },

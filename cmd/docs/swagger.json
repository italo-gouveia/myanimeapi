{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample API for managing anime and reviews.",
        "title": "MyAnimeAPI",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "email": "support@myanimeapi.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/reviews": {
            "post": {
                "description": "Create a new review with the input payload",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reviews"
                ],
                "summary": "Create a new review",
                "parameters": [
                    {
                        "description": "Review object",
                        "name": "review",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.Review"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.Review"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/reviews/{id}": {
            "get": {
                "description": "Get a review by its ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reviews"
                ],
                "summary": "Get a review by ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Review ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Review"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Anime": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "Creation timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "description": {
                    "description": "Description",
                    "type": "string",
                    "example": "A story about ninjas."
                },
                "id": {
                    "description": "Review ID",
                    "type": "integer",
                    "example": 1
                },
                "rating": {
                    "description": "Rating",
                    "type": "number",
                    "example": 8.5
                },
                "reviews": {
                    "description": "Relationship with Review",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Review"
                    }
                },
                "title": {
                    "description": "Title",
                    "type": "string",
                    "example": "Naruto"
                },
                "updated_at": {
                    "description": "Update timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                }
            }
        },
        "models.Review": {
            "type": "object",
            "properties": {
                "anime": {
                    "description": "Relationship with Anime",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.Anime"
                        }
                    ]
                },
                "anime_id": {
                    "description": "Anime ID",
                    "type": "integer",
                    "example": 1
                },
                "content": {
                    "description": "Review content",
                    "type": "string",
                    "example": "This anime is amazing!"
                },
                "created_at": {
                    "description": "Creation timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "id": {
                    "description": "Review ID",
                    "type": "integer",
                    "example": 1
                },
                "rating": {
                    "description": "Rating (0-10)",
                    "type": "integer",
                    "example": 9
                },
                "updated_at": {
                    "description": "Update timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "user": {
                    "description": "Relationship with User",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.User"
                        }
                    ]
                },
                "user_id": {
                    "description": "User ID",
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "models.User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "Creation timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "email": {
                    "description": "Email",
                    "type": "string",
                    "example": "john@example.com"
                },
                "id": {
                    "description": "Review ID",
                    "type": "integer",
                    "example": 1
                },
                "is_admin": {
                    "description": "IsAdmin",
                    "type": "boolean",
                    "example": false
                },
                "password": {
                    "description": "Password",
                    "type": "string",
                    "example": "password123"
                },
                "reviews": {
                    "description": "Relationship with Review",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Review"
                    }
                },
                "updated_at": {
                    "description": "Update timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "username": {
                    "description": "Username",
                    "type": "string",
                    "example": "john_doe"
                }
            }
        }
    }
}
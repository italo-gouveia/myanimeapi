    "definitions": {
        "models.Anime": {
            "type": "object",
            "required": [
                "title"
            ],
            "properties": {
                "created_at": {
                    "description": "Creation timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "description": {
                    "description": "Description",
                    "type": "string",
                    "maxLength": 500,
                    "example": "A story about ninjas."
                },
                "id": {
                    "description": "Review ID",
                    "type": "integer",
                    "example": 1
                },
                "rating": {
                    "description": "Rating                          // Rating",
                    "type": "number",
                    "maximum": 10,
                    "minimum": 0,
                    "example": 8.5
                },
                "reviews": {
                    "description": "Relationship with Review (omitted unless necessary)",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Review"
                    }
                },
                "title": {
                    "description": "Title",
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 3,
                    "example": "Naruto"
                },
                "updated_at": {
                    "description": "Update timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                }
            }
        },
        "models.Review": {
            "type": "object",
            "required": [
                "content",
                "rating"
            ],
            "properties": {
                "animeId": {
                    "description": "Add cascade delete constraint",
                    "type": "integer",
                    "example": 1
                },
                "content": {
                    "description": "Review content",
                    "type": "string",
                    "maxLength": 500,
                    "example": "This anime is amazing!"
                },
                "created_at": {
                    "description": "Creation timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "id": {
                    "description": "Review ID",
                    "type": "integer",
                    "example": 1
                },
                "rating": {
                    "description": "Rating (0-10)",
                    "type": "integer",
                    "maximum": 10,
                    "minimum": 0,
                    "example": 9
                },
                "updated_at": {
                    "description": "Update timestamp",
                    "type": "string",
                    "example": "2025-02-20T19:27:00Z"
                },
                "userId": {
                    "description": "User ID",
                    "type": "integer",
                    "example": 1
                }
            }
        },

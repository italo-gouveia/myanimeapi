# .env.example — copy to .env and fill in real values (never commit .env)

SERVER_HOST=localhost
SERVER_PORT=8080

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=myanimeapi

LOG_LEVEL=info
LOG_FILE=/var/log/myapp.log

API_KEY=your_api_key
# Must be at least 32 characters
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_chars_here
# Optional: override token expiry (default: 24)
JWT_EXPIRY_HOURS=24

SWAGGER_URL=http://localhost:8080/swagger/doc.json
# Required: comma-separated list of allowed origins (e.g. http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Email Configuration (required for password reset — server will warn if missing)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=your-email@example.com
EMAIL_PASSWORD=your-smtp-password
# Optional: override reset token expiry in minutes (default: 60)
RESET_TOKEN_EXPIRY_MINUTES=60
# Optional: rate limit for forgot-password endpoint (default: 5 requests per 1 hour per IP)
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_HOURS=1

# Admin User Creation (on initial setup if not exists)
ADMIN_USERNAME=myanime_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password

# AWS (production only)
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Redis (optional — omit or leave blank to disable caching and use no-op fallback)
# Format: redis://[:<password>@]<host>:<port>[/<db>]
REDIS_URL=redis://localhost:6379

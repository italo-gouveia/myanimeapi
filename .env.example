# .env.example — copy to .env and fill in real values (never commit .env)

SERVER_HOST=localhost
SERVER_PORT=8080

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=myanimeapi

LOG_LEVEL=info
LOG_FILE=/var/log/myapp.log

API_KEY=your_api_key
JWT_SECRET_KEY=your_jwt_secret_min_32_chars

SWAGGER_URL=http://localhost:8080/swagger/doc.json
ALLOWED_ORIGINS=*
ENVIRONMENT=development

# Email Configuration (for password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-email@example.com

# Admin User Creation (on initial setup if not exists)
ADMIN_USERNAME=myanime_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password

# AWS (production only)
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

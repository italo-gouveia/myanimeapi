ENV=production
ENVIRONMENT=production

PORT=8080
ALLOWED_ORIGINS=https://myanimeapi.com,https://www.myanimeapi.com

DB_HOST=your-production-db-host
DB_PORT=5432
DB_USER=your-production-db-user
DB_PASSWORD=your-production-db-password
DB_NAME=myanimeapi

JWT_SECRET_KEY=your-production-jwt-secret-key
JWT_EXPIRATION_HOURS=24

AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_BASE_URL=https://your-s3-bucket-name.s3.your-aws-region.amazonaws.com
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

SWAGGER_URL=/swagger

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=60

LOG_LEVEL=info
LOG_FORMAT=json

CORS_ALLOWED_ORIGINS=https://myanimeapi.com,https://www.myanimeapi.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=86400

UPLOAD_DIR=uploads
MEDIA_BASE_URL=/media

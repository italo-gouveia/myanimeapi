#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-push validation...${NC}"

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if golangci-lint is installed
if ! command_exists golangci-lint; then
    echo -e "${YELLOW}Installing golangci-lint...${NC}"
    go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
fi

# Run go mod tidy
echo -e "${YELLOW}Running go mod tidy...${NC}"
go mod tidy
if [ $? -ne 0 ]; then
    echo -e "${RED}go mod tidy failed${NC}"
    exit 1
fi

# Check for uncommitted changes
if [[ -n "$(git status --porcelain)" ]]; then
    echo -e "${RED}Found uncommitted changes after running 'go mod tidy'${NC}"
    git diff
    echo -e "${RED}Please commit the changes before pushing${NC}"
    exit 1
fi

# Run linter
echo -e "${YELLOW}Running golangci-lint...${NC}"
golangci-lint run ./...
if [ $? -ne 0 ]; then
    echo -e "${RED}Linting failed${NC}"
    exit 1
fi

# Run tests
echo -e "${YELLOW}Running tests...${NC}"
go test -v -race -coverprofile=coverage.out ./...
if [ $? -ne 0 ]; then
    echo -e "${RED}Tests failed${NC}"
    exit 1
fi

# Check test coverage
COVERAGE=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | sed 's/%//')
if (( $(echo "$COVERAGE < 80" | bc -l) )); then
    echo -e "${RED}Test coverage is below 80% (current: ${COVERAGE}%)${NC}"
    exit 1
fi

# Run go vet
echo -e "${YELLOW}Running go vet...${NC}"
go vet ./...
if [ $? -ne 0 ]; then
    echo -e "${RED}go vet failed${NC}"
    exit 1
fi

# Clean up
rm -f coverage.out

echo -e "${GREEN}All validations passed!${NC}"
exit 0 
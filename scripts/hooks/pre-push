#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-push validation...${NC}"

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if golangci-lint is installed
if ! command_exists golangci-lint; then
    echo -e "${YELLOW}Installing golangci-lint...${NC}"
    go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
fi

# Run go mod tidy
echo -e "${YELLOW}Running go mod tidy...${NC}"
go mod tidy
if [ $? -ne 0 ]; then
    echo -e "${RED}go mod tidy failed${NC}"
    exit 1
fi

# Check for uncommitted changes
if [[ -n "$(git status --porcelain)" ]]; then
    echo -e "${RED}Found uncommitted changes after running 'go mod tidy'${NC}"
    git diff
    echo -e "${RED}Please commit the changes before pushing${NC}"
    exit 1
fi

# Run linter
echo -e "${YELLOW}Running golangci-lint...${NC}"
golangci-lint run --timeout 10m ./...
if [ $? -ne 0 ]; then
    echo -e "${RED}Linting failed${NC}"
    exit 1
fi

# Determine test packages
# By default, skip integration and E2E tests during pre-push to avoid external dependencies
# Set RUN_ALL_TESTS=1 to include everything (CI should do this)
if [ "${RUN_ALL_TESTS}" = "1" ]; then
    TEST_PKGS=$(go list ./...)
else
    TEST_PKGS=$(go list ./... | grep -v 'tests/integration' | grep -v 'tests/e2e')
fi

# Check if gcc is installed for race detection
if command_exists gcc; then
    echo -e "${YELLOW}Running unit tests with race detection...${NC}"
    CGO_ENABLED=1 go test -v -race -coverprofile=coverage.out ${TEST_PKGS}
else
    echo -e "${YELLOW}GCC not found. Running unit tests without race detection...${NC}"
    go test -v -coverprofile=coverage.out ${TEST_PKGS}
fi

if [ $? -ne 0 ]; then
    echo -e "${RED}Tests failed${NC}"
    exit 1
fi

# Check test coverage
COVERAGE=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | sed 's/%//')
if command_exists bc; then
    if (( $(echo "$COVERAGE < 5" | bc -l) )); then
        echo -e "${RED}Test coverage is below 5% (current: ${COVERAGE}%)${NC}"
        exit 1
    fi
else
    # Simple integer comparison if bc is not available
    COVERAGE_INT=${COVERAGE%.*}
    if [ "$COVERAGE_INT" -lt 5 ]; then
        echo -e "${RED}Test coverage is below 5% (current: ${COVERAGE}%)${NC}"
        exit 1
    fi
fi

# Run go vet
echo -e "${YELLOW}Running go vet...${NC}"
go vet ./...
if [ $? -ne 0 ]; then
    echo -e "${RED}go vet failed${NC}"
    exit 1
fi

# Clean up
rm -f coverage.out

echo -e "${GREEN}All validations passed!${NC}"
exit 0 